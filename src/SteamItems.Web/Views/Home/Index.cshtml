@{
    ViewData["Title"] = "Home";
    var links = new (string Controller, string Action, string Icon, string Title, string Text)[]
    {
        ("Items", "Index", "sports_esports", "Steam items", "Pick the games to export, then download or upload the Excel file."),
        ("Exports", "Index", "upload_file", "Exports", "Follow the files the Worker is processing, live, and see their rows."),
        ("Home", "Profile", "account_circle", "Profile", "The claims and session data issued by SteamItems.Identity."),
    };
}

<div class="card bg-white rounded-10 border border-white p-20 mb-4">
    <h3 class="fs-26 fw-medium mb-10">Welcome</h3>
    <p class="fs-16 lh-1-8 mb-0">
        Select Steam items, export them to Excel and let the Worker process the file in the background.
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account" asp-action="Login" class="text-primary text-decoration-none">Log in</a>
            <text>to get started.</text>
        }
    </p>
</div>

<div class="row">
    @foreach (var link in links)
    {
        <div class="col-lg-4 col-md-6">
            <a asp-controller="@link.Controller" asp-action="@link.Action" class="card bg-white rounded-10 border border-white p-20 mb-4 d-block text-decoration-none">
                <div class="d-flex align-items-center">
                    <span class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary" style="width: 50px; height: 50px;">
                        <span class="material-symbols-outlined">@link.Icon</span>
                    </span>
                    <div class="flex-grow-1 ms-3">
                        <h3 class="fs-18 fw-medium mb-1">@link.Title</h3>
                        <p class="fs-15 mb-0">@link.Text</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
