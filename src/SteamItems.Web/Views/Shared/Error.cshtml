@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card bg-white border border-white rounded-10 p-20 text-center mb-4">
    <div class="mb-20">
        <span class="material-symbols-outlined text-danger" style="font-size: 80px;">error</span>
    </div>
    <h3 class="fs-26 mb-10">An error occurred while processing your request.</h3>

    @if (Model.ShowRequestId)
    {
        <p class="fs-16 mb-10">Request ID: <code>@Model.RequestId</code></p>
    }

    <p class="fs-16 lh-1-8 mb-10">
        Swapping to the <strong>Development</strong> environment will display more detailed information about the error that occurred.
    </p>
    <p class="fs-15 lh-1-8 mb-4">
        The Development environment shouldn't be enabled for deployed applications: it can show sensitive information from exceptions to end users.
        For local debugging, set the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong> and restart the app.
    </p>
    <div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary text-white">Back to Home</a>
    </div>
</div>
