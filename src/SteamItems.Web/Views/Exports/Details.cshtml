@using System.Globalization
@using SteamItems.Contracts.Status
@using SteamItems.Web.Data
@using SteamItems.Web.Status
@model ExportDetails
@{
    var export = Model.Export;
    var rows = Model.Rows;
    ViewData["Title"] = export.FileName;
    var started = export.Status != ExportStatus.Pending;
    var waiting = Model.State is ExportRowsState.Pending or ExportRowsState.Processing;
    var counts = new (string Label, string Icon, string Color, string Value)[]
    {
        ("Items", "list_alt", "primary", export.ItemCount.ToString()),
        ("Processed", "task_alt", "success", started ? export.ProcessedCount.ToString() : "–"),
        ("Failed", "cancel", "danger", started ? export.FailedCount.ToString() : "–"),
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <a asp-action="Index" class="text-primary text-decoration-none fs-16 d-inline-flex align-items-center">
        <span class="material-symbols-outlined fs-18 me-1">west</span> Exports
    </a>
</div>

@* data-status: export-details.js reloads the page when the Worker's outcome for this export changes. *@
<div id="export-header" data-export-id="@export.Id" data-status="@export.Status" data-hub-url="@ExportsHub.Path">
    <div class="row">
        <div class="col-xxl-3 col-sm-6">
            <div class="card bg-white p-20 rounded-10 border border-white mb-4">
                <span class="fs-16 d-block mb-2">Status</span>
                <div><span class="@export.Status.BadgeClass()">@export.Status.DisplayText()</span></div>
            </div>
        </div>
        @foreach (var count in counts)
        {
            <div class="col-xxl-3 col-sm-6">
                <div class="card bg-white p-20 rounded-10 border border-white mb-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="fs-16 d-block mb-2">@count.Label</span>
                            <h3 class="fs-26 fw-medium mb-0">@count.Value</h3>
                        </div>
                        <span class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-@count.Color bg-opacity-10 text-@count.Color" style="width: 50px; height: 50px;">
                            <span class="material-symbols-outlined">@count.Icon</span>
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card bg-white p-20 rounded-10 border border-white mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <span class="fs-15 d-block mb-1">Created (UTC)</span>
                <span class="fs-16 text-secondary">@export.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>
            <div class="col-md-4">
                <span class="fs-15 d-block mb-1">Completed (UTC)</span>
                <span class="fs-16 text-secondary">@(export.CompletedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "–")</span>
            </div>
            <div class="col-md-4">
                <span class="fs-15 d-block mb-1">Storage key</span>
                <code class="text-break">@export.ObjectKey</code>
            </div>
        </div>
    </div>
</div>

@switch (Model.State)
{
    case ExportRowsState.Pending:
        <div class="alert fs-16 alert-secondary text-secondary" role="status">
            The Worker has not picked up this file yet. Its rows show here once it is imported; this page reloads by itself.
        </div>
        break;
    case ExportRowsState.Processing:
        <div class="alert fs-16 alert-primary text-primary" role="status">
            The Worker is still importing this file. Its rows show here once it is done; this page reloads by itself.
        </div>
        break;
    case ExportRowsState.Rejected:
        <div class="alert fs-16 alert-danger text-danger" role="alert">
            The Worker could not read this file, so no rows were stored.
            @if (export.Error is not null)
            {
                <div class="fs-14 mt-1">@export.Error</div>
            }
        </div>
        break;
    case ExportRowsState.WorkerUnavailable:
        <div class="alert fs-16 alert-warning text-warning" role="alert">
            The rows are not available right now: the Worker did not answer. Try again in a moment.
        </div>
        break;
    case ExportRowsState.Missing:
        <div class="alert fs-16 alert-warning text-warning" role="alert">The Worker has no rows for this file.</div>
        break;
    case ExportRowsState.Available when rows is not null:
        <div class="card bg-white rounded-10 border border-white mb-4">
            <div class="d-flex flex-wrap gap-2 p-20">
                @foreach (var (label, filter, count) in new (string, FileItemStatus?, int)[]
                {
                    ("All", null, rows.ProcessedCount + rows.FailedCount),
                    ("Processed", FileItemStatus.Processed, rows.ProcessedCount),
                    ("Failed", FileItemStatus.Failed, rows.FailedCount),
                })
                {
                    var active = rows.Filter == filter;
                    <a class="btn fw-normal @(active ? "btn-primary text-white" : "btn-outline-primary")" aria-current="@(active ? "page" : null)"
                       asp-action="Details" asp-route-id="@export.Id" asp-route-status="@filter">
                        @label <span class="ms-1 opacity-75">@count</span>
                    </a>
                }
            </div>

            @if (rows.Items.Count == 0)
            {
                <div class="text-center px-20 pb-4">
                    <p class="fs-16 mb-0">
                        @(rows.TotalCount == 0 ? "No rows." : "No rows on this page.")
                        @if (rows.TotalCount > 0)
                        {
                            <a asp-action="Details" asp-route-id="@export.Id" asp-route-status="@rows.Filter" class="text-primary text-decoration-none">Go to the first page</a>
                        }
                    </p>
                </div>
            }
            else
            {
                <div class="default-table-area mx-minus-1">
                    <div class="table-responsive">
                        <table class="table align-middle w-100 text-nowrap">
                            <thead>
                                <tr>
                                    <th scope="col" class="fw-medium text-end">Row</th>
                                    <th scope="col" class="fw-medium">Status</th>
                                    <th scope="col" class="fw-medium text-end">AppId</th>
                                    <th scope="col" class="fw-medium">Name</th>
                                    <th scope="col" class="fw-medium text-end">Price</th>
                                    <th scope="col" class="fw-medium">Release date</th>
                                    <th scope="col" class="fw-medium">Error</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in rows.Items)
                                {
                                    <tr>
                                        <td class="text-body text-end">@item.RowNumber</td>
                                        <td><span class="@item.Status.BadgeClass()">@item.Status</span></td>
                                        <td class="text-body text-end">@item.AppId</td>
                                        <td class="text-secondary">@item.Name</td>
                                        <td class="text-body text-end">@item.Price?.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                        <td class="text-body">@item.ReleaseDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                                        <td class="fs-14 text-danger text-wrap" style="min-width: 200px;">@item.Error</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (rows.PageCount > 1)
            {
                var first = rows.Page <= 1;
                var last = rows.Page >= rows.PageCount;
                <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
                    <span class="fs-15">Page @rows.Page of @rows.PageCount, @rows.TotalCount rows</span>

                    <nav class="custom-pagination" aria-label="Row pages">
                        <ul class="pagination mb-0 justify-content-center">
                            <li class="page-item @(first ? "disabled" : "")">
                                <a class="page-link icon" aria-label="First" asp-action="Details" asp-route-id="@export.Id" asp-route-status="@rows.Filter">
                                    <i class="material-symbols-outlined">first_page</i>
                                </a>
                            </li>
                            <li class="page-item @(first ? "disabled" : "")">
                                <a class="page-link icon" aria-label="Previous" asp-action="Details" asp-route-id="@export.Id" asp-route-status="@rows.Filter"
                                   asp-route-page="@(rows.Page - 1)">
                                    <i class="material-symbols-outlined">west</i>
                                </a>
                            </li>
                            <li class="page-item">
                                <span class="page-link active">@rows.Page</span>
                            </li>
                            <li class="page-item @(last ? "disabled" : "")">
                                <a class="page-link icon" aria-label="Next" asp-action="Details" asp-route-id="@export.Id" asp-route-status="@rows.Filter"
                                   asp-route-page="@(rows.Page + 1)">
                                    <i class="material-symbols-outlined">east</i>
                                </a>
                            </li>
                            <li class="page-item @(last ? "disabled" : "")">
                                <a class="page-link icon" aria-label="Last" asp-action="Details" asp-route-id="@export.Id" asp-route-status="@rows.Filter"
                                   asp-route-page="@rows.PageCount">
                                    <i class="material-symbols-outlined">last_page</i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
        break;
}

@section Scripts {
    @if (waiting)
    {
        <script src="~/lib/microsoft-signalr/dist/browser/signalr.min.js"></script>
        <script src="~/js/export-details.js" asp-append-version="true"></script>
    }
}
