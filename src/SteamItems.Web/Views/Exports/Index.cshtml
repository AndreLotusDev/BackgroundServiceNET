@model List<SteamItems.Web.Data.ExportRecord>
@{
    ViewData["Title"] = "Exports";
}

<h1>Exports</h1>
<p>Excel files you submitted for processing.</p>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success" role="status">@status</div>
}

@if (Model.Count == 0)
{
    <p>No exports yet. Save a selection on <a asp-controller="Items" asp-action="Index">Steam items</a> and click <strong>Upload Excel</strong>.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th scope="col">Created (UTC)</th>
                <th scope="col">File</th>
                <th scope="col" class="text-end">Items</th>
                <th scope="col">Storage key</th>
                <th scope="col">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var export in Model)
            {
                <tr>
                    <td>@export.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@export.FileName</td>
                    <td class="text-end">@export.ItemCount</td>
                    <td><code>@export.ObjectKey</code></td>
                    <td><span class="badge text-bg-secondary">@export.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
}
