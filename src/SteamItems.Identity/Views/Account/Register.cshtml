@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="text-center mb-4">
    <h3 class="fs-26 fw-medium" style="margin-bottom: 6px;">Create an account</h3>
    <p class="fs-16 lh-1-8">
        Already registered? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary text-decoration-none">Log in</a>
    </p>
</div>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger fs-15 mb-20"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-20">
        <label asp-for="UserName" class="label fs-16 mb-2"></label>
        <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="UserName"></span>
    </div>
    <div class="mb-20">
        <label asp-for="Email" class="label fs-16 mb-2"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="mb-20">
        <label asp-for="Password" class="label fs-16 mb-2"></label>
        <div class="password-wrapper position-relative password-container">
            <input asp-for="Password" class="form-control password" autocomplete="new-password" />
            <i style="color: #A9A9C8; font-size: 22px; right: 15px;" class="ri-eye-off-line password-toggle-icon translate-middle-y top-50 position-absolute cursor" aria-hidden="true"></i>
        </div>
        <span asp-validation-for="Password"></span>
    </div>
    <div class="mb-20">
        <label asp-for="ConfirmPassword" class="label fs-16 mb-2"></label>
        <div class="password-wrapper position-relative password-container">
            <input asp-for="ConfirmPassword" class="form-control password" autocomplete="new-password" />
            <i style="color: #A9A9C8; font-size: 22px; right: 15px;" class="ri-eye-off-line password-toggle-icon translate-middle-y top-50 position-absolute cursor" aria-hidden="true"></i>
        </div>
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
    <button type="submit" class="btn btn-primary fw-normal text-white w-100" style="padding-top: 18px; padding-bottom: 18px;">Register</button>
</form>
